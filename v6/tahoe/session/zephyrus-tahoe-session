#!/usr/bin/env bash
# ZEPHYRUS v6 Tahoe SDDM session launcher (STAGED TEMPLATE).
# ONLY called when the user explicitly selects the Tahoe SDDM entry.
# It never edits ~/.config/hypr, switches rices, or loads plugins.
set -euo pipefail

config="${XDG_DATA_HOME:-$HOME/.local/share}/zephyrus-v6/tahoe-session/hyprland.lua"
error() { printf 'ZEPHYRUS Tahoe: %s\n' "$*" >&2; exit 1; }
[[ "${EUID:-$(id -u)}" -ne 0 ]] || error "refusing to launch a graphical user session as root."
command -v start-hyprland >/dev/null 2>&1 ||
    error "start-hyprland is missing; choose an existing session at SDDM."
command -v foot >/dev/null 2>&1 ||
    error "Foot terminal is missing; choose an existing session at SDDM."
[[ -r "$config" ]] ||
    error "Tahoe config not installed: $config. Choose the original Multi-Rice session."

# No UWSM, no inherited profile sources, no systemd service edits, no
# environment poisoning of the user's existing login entries.
# start-hyprland 0.56.2 forwards everything after -- to Hyprland.
exec start-hyprland -- --config "$config"
