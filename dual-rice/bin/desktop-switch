#!/usr/bin/env bash

set -euo pipefail

ROOT="$HOME/.local/share/desktop-profiles"
ACTIVE_DIR="$HOME/.config/desktop-profile"
ACTIVE_FILE="$ACTIVE_DIR/active"
HYPR_LINK="$HOME/.config/hypr"
FUZZEL_CFG="$HOME/.config/desktop-switcher/fuzzel.ini"

mkdir -p "$ACTIVE_DIR"

die() {
    notify-send "Desktop Switcher" "$*" 2>/dev/null || true
    echo "desktop-switch: $*" >&2
    exit 1
}

profile_target() {
    local target="$ROOT/$1/hypr"
    [ -f "$target/hyprland.lua" ] || return 1
    printf '%s\n' "$target"
}

pretty_name() {
    case "$1" in
        caelestia) echo "Caelestia" ;;
        end4) echo "end4-pC" ;;
        ambxst) echo "Ambxst" ;;
        dms) echo "DankMaterialShell" ;;
        *) echo "$1" ;;
    esac
}

profile_icon() {
    case "$1" in
        caelestia) echo "✦" ;;
        end4) echo "◈" ;;
        ambxst) echo "◆" ;;
        dms) echo "●" ;;
        *) echo "○" ;;
    esac
}

list_profiles() {
    local preferred=(caelestia end4 ambxst dms)
    local p dir

    for p in "${preferred[@]}"; do
        if profile_target "$p" >/dev/null 2>&1; then
            printf '%s\n' "$p"
        fi
    done

    for dir in "$ROOT"/*; do
        [ -d "$dir" ] || continue
        p="$(basename "$dir")"
        case "$p" in
            caelestia|end4|ambxst|dms) continue ;;
        esac
        if profile_target "$p" >/dev/null 2>&1; then
            printf '%s\n' "$p"
        fi
    done
}

current_profile() {
    local saved resolved

    if [ -f "$ACTIVE_FILE" ]; then
        saved="$(cat "$ACTIVE_FILE")"
        if profile_target "$saved" >/dev/null 2>&1; then
            printf '%s\n' "$saved"
            return
        fi
    fi

    if [ -L "$HYPR_LINK" ]; then
        resolved="$(readlink -f "$HYPR_LINK" 2>/dev/null || true)"
        if [ -n "$resolved" ] && [ "$(dirname "$resolved")" != "$resolved" ]; then
            saved="$(basename "$(dirname "$resolved")")"
            if [ "$resolved" = "$ROOT/$saved/hypr" ] && profile_target "$saved" >/dev/null 2>&1; then
                printf '%s\n' "$saved"
                return
            fi
        fi
    fi

    echo "unknown"
}

switch_profile() {
    local profile="$1"
    local target tmp

    target="$(profile_target "$profile")" || die "Unknown or incomplete profile: $profile"

    if [ -e "$HYPR_LINK" ] && [ ! -L "$HYPR_LINK" ]; then
        die "$HYPR_LINK is not a symlink. Refusing to modify it."
    fi

    tmp="$HOME/.config/.hypr-profile-switch.$$"
    rm -f "$tmp"
    ln -s "$target" "$tmp"
    mv -Tf "$tmp" "$HYPR_LINK"

    printf '%s\n' "$profile" > "$ACTIVE_FILE"

    notify-send \
        "Desktop Profile" \
        "$(pretty_name "$profile") selected" \
        2>/dev/null || true
}

gui_choose_profile() {
    command -v fuzzel >/dev/null || die "Fuzzel is not installed"

    local current choice p label count i
    local -a profiles=()
    local -a labels=()

    current="$(current_profile)"

    while IFS= read -r p; do
        [ -n "$p" ] || continue
        profiles+=("$p")
        if [ "$p" = "$current" ]; then
            label="✓  $(profile_icon "$p")  $(pretty_name "$p")        ACTIVE"
        else
            label="   $(profile_icon "$p")  $(pretty_name "$p")"
        fi
        labels+=("$label")
    done < <(list_profiles)

    count="${#profiles[@]}"
    [ "$count" -gt 0 ] || die "No desktop profiles found under $ROOT"

    choice="$(
        printf '%s\n' "${labels[@]}" |
        fuzzel \
            --config="$FUZZEL_CFG" \
            --dmenu \
            --lines="$count" \
            --prompt='  Desktop  ❯  ' \
            --mesg="Current profile: $(pretty_name "$current")"
    )" || exit 0

    for ((i = 0; i < count; i++)); do
        if [ "$choice" = "${labels[$i]}" ]; then
            printf '%s\n' "${profiles[$i]}"
            return
        fi
    done

    exit 0
}

confirm_switch() {
    local selected="$1"
    local current="$2"
    local choice

    if [ "$selected" = "$current" ]; then
        notify-send \
            "Desktop Profile" \
            "$(pretty_name "$selected") is already active" \
            2>/dev/null || true
        exit 0
    fi

    choice="$(
        printf '%s\n' \
            "⚡  Switch to $(pretty_name "$selected") now" \
            "←   Cancel" |
        fuzzel \
            --config="$FUZZEL_CFG" \
            --dmenu \
            --lines=2 \
            --prompt='  Confirm  ❯  ' \
            --mesg="$(pretty_name "$current")  →  $(pretty_name "$selected")"
    )" || exit 0

    case "$choice" in
        *Switch*)
            switch_profile "$selected"
            notify-send "Desktop Switcher" "Logging out…" 2>/dev/null || true
            sleep 1
            hyprctl dispatch 'hl.dsp.exit()'
            ;;
        *)
            exit 0
            ;;
    esac
}

case "${1:-}" in
    status)
        echo "Active profile: $(current_profile)"
        echo "Hyprland target: $(readlink -f "$HYPR_LINK" 2>/dev/null || echo unknown)"
        ;;

    list)
        list_profiles
        ;;

    "")
        current="$(current_profile)"
        selected="$(gui_choose_profile)"
        confirm_switch "$selected" "$current"
        ;;

    *)
        selected="$1"
        profile_target "$selected" >/dev/null 2>&1 || {
            echo "Unknown profile: $selected" >&2
            echo "Available profiles:" >&2
            list_profiles >&2
            exit 1
        }

        switch_profile "$selected"
        if [ "${2:-}" = "--now" ]; then
            sleep 1
            hyprctl dispatch 'hl.dsp.exit()'
        elif [ -n "${2:-}" ]; then
            echo "Usage: desktop-switch <profile> [--now]" >&2
            exit 1
        fi
        ;;
esac
