#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="$CONFIG_HOME/desktop-profile"
STATE_FILE="$STATE_DIR/revo-shell"
QS_ROOT="$CONFIG_HOME/quickshell"
DEFAULT_SHELL="lucid"
LOG_FILE="$STATE_DIR/revo-shell-launch.log"

mkdir -p "$STATE_DIR"

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG_FILE"
}

stop_all_quickshell() {
    pkill -9 -f "ryoku/shell/ipc/ryoku-shell" >/dev/null 2>&1 || true
    pkill -9 -f "quickshell -p" >/dev/null 2>&1 || true
    pkill -9 -f "quickshell -c" >/dev/null 2>&1 || true
    pkill -9 -f "qs -p" >/dev/null 2>&1 || true
    pkill -9 -f "qs -c" >/dev/null 2>&1 || true
    pkill -9 -x quickshell >/dev/null 2>&1 || true

    for _ in $(seq 1 10); do
        pgrep -x quickshell >/dev/null 2>&1 || break
        sleep 0.1
    done
}

replace=0
if [[ "${1:-}" == "--replace" ]]; then
    replace=1
    shift
fi

shell="${REVO_SHELL:-}"
if [[ -z "$shell" && -f "$STATE_FILE" ]]; then
    shell="$(tr -d '[:space:]' < "$STATE_FILE")"
fi
shell="${shell:-$DEFAULT_SHELL}"

dir="$QS_ROOT/$shell"
[[ -d "$dir" ]] || {
    log "ERROR shell '$shell' is not installed at $dir"
    echo "revo-shell-launch: shell '$shell' is not installed at $dir" >&2
    exit 4
}

if (( replace )); then
    log "Replacing current Quickshell with '$shell'"
    stop_all_quickshell
fi

runner=""
if command -v quickshell >/dev/null 2>&1; then
    runner="quickshell"
elif command -v qs >/dev/null 2>&1; then
    runner="qs"
else
    log "ERROR Quickshell is not installed"
    echo "revo-shell-launch: Quickshell is not installed" >&2
    exit 4
fi

case "$shell" in
    macos)
        log "Launching macos"
        setsid -f "$runner" -p "$dir/shell.qml" >"$HOME/macos.log" 2>&1

        if [[ -x "$QS_ROOT/k4/arrancar" ]]; then
            setsid -f "$QS_ROOT/k4/arrancar" >/tmp/k4.log 2>&1
        fi
        exit 0
        ;;

    ii)
        log "Launching ii"
        exec "$runner" -p "$dir"
        ;;

    k4)
        if [[ -x "$dir/arrancar" ]]; then
            log "Launching k4 wrapper"
            exec "$dir/arrancar"
        fi
        ;;

    ryoku)
        if [[ -x "$dir/launch.sh" ]]; then
            log "Launching ryoku wrapper"
            exec "$dir/launch.sh"
        fi
        ;;
esac

if [[ -f "$dir/shell.qml" ]]; then
    if [[ -d "$dir/build/qml" ]]; then
        export QML2_IMPORT_PATH="$dir/build/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
    elif [[ -d "$dir/api" ]]; then
        export QML2_IMPORT_PATH="$dir/api${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
    fi

    log "Launching '$shell' from $dir/shell.qml"
    exec "$runner" -p "$dir/shell.qml"
fi

if [[ -x "$dir/launch.sh" ]]; then
    log "Launching '$shell' through launch.sh"
    exec "$dir/launch.sh"
fi

if [[ -x "$dir/arrancar" ]]; then
    log "Launching '$shell' through arrancar"
    exec "$dir/arrancar"
fi

log "ERROR no launchable entry point for '$shell'"
echo "revo-shell-launch: no launchable entry point for '$shell'" >&2
exit 4
