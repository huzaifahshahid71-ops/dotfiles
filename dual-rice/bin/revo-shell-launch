#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="$CONFIG_HOME/desktop-profile"
STATE_FILE="$STATE_DIR/revo-shell"
QS_ROOT="$CONFIG_HOME/quickshell"
DEFAULT_SHELL="lucid"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/revo-v5.1"
LAUNCH_LOG="$LOG_DIR/launcher.log"

mkdir -p "$STATE_DIR" "$LOG_DIR"

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LAUNCH_LOG"
}

ensure_revo_wallpaper() {
    local wallpaper_dir="$HOME/Pictures/Wallpapers/Revo"
    local wall=""

    [[ -d "$wallpaper_dir" ]] || return 0

    if command -v awww >/dev/null 2>&1; then
        pgrep -x awww-daemon >/dev/null 2>&1 || {
            setsid -f awww-daemon >"$LOG_DIR/awww.log" 2>&1
            sleep 0.35
        }

        if awww query 2>/dev/null | grep -q 'image:'; then
            return 0
        fi

        wall="$(find "$wallpaper_dir" -type f \
            \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
            -print 2>/dev/null | shuf -n 1)"
        [[ -n "$wall" && -f "$wall" ]] || return 0
        awww img --transition-type none "$wall" >/dev/null 2>&1 || true
        log "Seeded Revo wallpaper via awww: $wall"
        return 0
    fi

    if command -v swww >/dev/null 2>&1; then
        pgrep -x swww-daemon >/dev/null 2>&1 || {
            setsid -f swww-daemon >"$LOG_DIR/swww.log" 2>&1
            sleep 0.35
        }

        if swww query 2>/dev/null | grep -q 'image:'; then
            return 0
        fi

        wall="$(find "$wallpaper_dir" -type f \
            \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
            -print 2>/dev/null | shuf -n 1)"
        [[ -n "$wall" && -f "$wall" ]] || return 0
        swww img "$wall" --transition-type none >/dev/null 2>&1 || true
        log "Seeded Revo wallpaper via swww: $wall"
    fi
}


stop_all_quickshell() {
    pkill -9 -f "ryoku/shell/ipc/ryoku-shell" >/dev/null 2>&1 || true
    pkill -9 -f "quickshell -p" >/dev/null 2>&1 || true
    pkill -9 -f "quickshell -c" >/dev/null 2>&1 || true
    pkill -9 -f "qs -p" >/dev/null 2>&1 || true
    pkill -9 -f "qs -c" >/dev/null 2>&1 || true
    pkill -9 -x quickshell >/dev/null 2>&1 || true
    pkill -9 -x qs >/dev/null 2>&1 || true

    for _ in $(seq 1 15); do
        if ! pgrep -x quickshell >/dev/null 2>&1 &&
           ! pgrep -x qs >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
}

replace=0
if [[ "${1:-}" == "--replace" ]]; then
    replace=1
    shift
fi

shell="${REVO_SHELL:-}"
if [[ -z "$shell" && -f "$STATE_FILE" ]]; then
    shell="$(tr -d '[:space:]' < "$STATE_FILE")"
fi
shell="${shell:-$DEFAULT_SHELL}"

dir="$QS_ROOT/$shell"
shell_log="$LOG_DIR/$shell.log"

[[ -d "$dir" ]] || {
    log "ERROR shell '$shell' is not installed at $dir"
    exit 4
}

if (( replace )); then
    log "Replacing current shell with '$shell'"
    stop_all_quickshell
fi

ensure_revo_wallpaper

runner=""
if command -v quickshell >/dev/null 2>&1; then
    runner="$(command -v quickshell)"
elif command -v qs >/dev/null 2>&1; then
    runner="$(command -v qs)"
else
    log "ERROR Quickshell is not installed"
    exit 4
fi

# Keep one log per shell so failed hot-switches are diagnosable.
: > "$shell_log"

case "$shell" in
    macos)
        log "Launching macos -> $shell_log"
        setsid -f "$runner" -p "$dir/shell.qml" >"$shell_log" 2>&1

        # Revo intentionally pairs Mac with K4's Dynamic Island.
        if [[ -x "$QS_ROOT/k4/arrancar" ]]; then
            setsid -f "$QS_ROOT/k4/arrancar" >"$LOG_DIR/k4-macos.log" 2>&1
        fi
        ;;

    ii)
        log "Launching ii -> $shell_log"
        setsid -f "$runner" -p "$dir" >"$shell_log" 2>&1
        ;;

    k4)
        [[ -x "$dir/arrancar" ]] || exit 4
        log "Launching k4 wrapper -> $shell_log"
        setsid -f "$dir/arrancar" >"$shell_log" 2>&1
        ;;

    ryoku)
        [[ -x "$dir/launch.sh" ]] || exit 4
        log "Launching ryoku wrapper -> $shell_log"
        setsid -f bash -c "$dir/launch.sh" >"$shell_log" 2>&1
        ;;

    *)
        if [[ -f "$dir/shell.qml" ]]; then
            if [[ -d "$dir/build/qml" ]]; then
                export QML2_IMPORT_PATH="$dir/build/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
            elif [[ -d "$dir/api" ]]; then
                export QML2_IMPORT_PATH="$dir/api${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
            fi

            log "Launching '$shell' -> $shell_log"
            setsid -f "$runner" -p "$dir/shell.qml" >"$shell_log" 2>&1
        elif [[ -x "$dir/launch.sh" ]]; then
            log "Launching '$shell' through launch.sh -> $shell_log"
            setsid -f "$dir/launch.sh" >"$shell_log" 2>&1
        elif [[ -x "$dir/arrancar" ]]; then
            log "Launching '$shell' through arrancar -> $shell_log"
            setsid -f "$dir/arrancar" >"$shell_log" 2>&1
        else
            log "ERROR no launchable entry point for '$shell'"
            exit 4
        fi
        ;;
esac

# Give the detached client a moment to fail fast. This does not prove a shell
# is healthy, but catches missing-QML/module failures in its persistent log.
sleep 0.35
log "Launch request for '$shell' completed"
exit 0
