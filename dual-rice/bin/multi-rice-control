#!/usr/bin/env bash

set -euo pipefail

ROOT="$HOME/.local/share/desktop-profiles"
STATE_DIR="$HOME/.config/desktop-profile"
ACTIVE_FILE="$STATE_DIR/active"

HYPR_LINK="$HOME/.config/hypr"
NIRI_LINK="$HOME/.config/niri"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

load_metadata() {
    local candidate

    for candidate in         "$HOME/.local/share/desktop-switcher/profile-metadata.sh"         "$SCRIPT_DIR/../lib/profile-metadata.sh"
    do
        if [ -f "$candidate" ]; then
            source "$candidate"
            return 0
        fi
    done

    echo "multi-rice-control: profile metadata not found" >&2
    exit 1
}

load_metadata

is_installed() {
    profile_config_path "$ROOT" "$1" >/dev/null 2>&1
}

detect_compositor() {
    local xdg="${XDG_CURRENT_DESKTOP:-}"
    xdg="${xdg,,}"

    if [ -n "${NIRI_SOCKET:-}" ] || [[ "$xdg" == *niri* ]]; then
        echo "niri"
        return
    fi

    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || [[ "$xdg" == *hyprland* ]]; then
        echo "hyprland"
        return
    fi

    echo "unknown"
}

profile_from_link() {
    local compositor="$1"
    local link=""
    local profile target resolved

    case "$compositor" in
        hyprland) link="$HYPR_LINK" ;;
        niri)     link="$NIRI_LINK" ;;
        *)        return 1 ;;
    esac

    [ -L "$link" ] || return 1

    resolved="$(readlink -f "$link" 2>/dev/null || true)"
    [ -n "$resolved" ] || return 1

    while IFS= read -r profile; do
        target="$(profile_config_path "$ROOT" "$profile" 2>/dev/null || true)"

        if [ -n "$target" ] && [ "$resolved" = "$target" ]; then
            printf "%s
" "$profile"
            return 0
        fi
    done < <(profile_ids_for_compositor "$compositor")

    return 1
}

current_profile() {
    local compositor saved saved_comp

    compositor="$(detect_compositor)"

    if [ -f "$ACTIVE_FILE" ]; then
        saved="$(tr -d "[:space:]" < "$ACTIVE_FILE")"
        saved_comp="$(profile_compositor "$saved" 2>/dev/null || true)"

        if [ -n "$saved_comp" ] &&
           is_installed "$saved" &&
           { [ "$compositor" = "unknown" ] || [ "$saved_comp" = "$compositor" ]; }
        then
            printf "%s
" "$saved"
            return
        fi
    fi

    profile_from_link "$compositor" 2>/dev/null || echo "unknown"
}

count_installed() {
    local compositor="$1"
    local profile count=0

    while IFS= read -r profile; do
        if is_installed "$profile"; then
            count=$((count + 1))
        fi
    done < <(profile_ids_for_compositor "$compositor")

    printf "%s
" "$count"
}

show_status() {
    local compositor profile name icon profile_comp installed

    compositor="$(detect_compositor)"
    profile="$(current_profile)"

    if [ "$profile" != "unknown" ]; then
        name="$(profile_name "$profile")"
        icon="$(profile_icon "$profile")"
        profile_comp="$(profile_compositor "$profile")"

        if is_installed "$profile"; then
            installed="true"
        else
            installed="false"
        fi
    else
        name="Unknown"
        icon="?"
        profile_comp="unknown"
        installed="false"
    fi

    printf "compositor=%s
" "$compositor"
    printf "profile=%s
" "$profile"
    printf "name=%s
" "$name"
    printf "icon=%s
" "$icon"
    printf "profile_compositor=%s
" "$profile_comp"
    printf "installed=%s
" "$installed"
    printf "hyprland_installed=%s
" "$(count_installed hyprland)"
    printf "niri_installed=%s
" "$(count_installed niri)"
}

show_list() {
    local active profile compositor installed active_flag

    active="$(current_profile)"

    while IFS= read -r profile; do
        compositor="$(profile_compositor "$profile")"

        if is_installed "$profile"; then
            installed="true"
        else
            installed="false"
        fi

        if [ "$profile" = "$active" ]; then
            active_flag="true"
        else
            active_flag="false"
        fi

        printf "%s|%s|%s|%s|%s|%s
"             "$profile"             "$(profile_name "$profile")"             "$(profile_icon "$profile")"             "$compositor"             "$installed"             "$active_flag"
    done < <(profile_ids)
}

plan_switch() {
    local profile="${1:-}"
    local current current_comp target_comp installed action

    if [ -z "$profile" ]; then
        echo "multi-rice-control: plan requires a profile id" >&2
        return 2
    fi

    target_comp="$(profile_compositor "$profile" 2>/dev/null || true)"

    if [ -z "$target_comp" ]; then
        echo "multi-rice-control: unknown profile: $profile" >&2
        return 2
    fi

    current_comp="$(detect_compositor)"
    current="$(current_profile)"

    if is_installed "$profile"; then
        installed="true"
    else
        installed="false"
    fi

    if [ "$installed" != "true" ]; then
        action="unavailable"
    elif [ "$profile" = "$current" ]; then
        action="noop"
    elif [ "$current_comp" = "unknown" ]; then
        action="unsupported-session"
    elif [ "$target_comp" = "$current_comp" ]; then
        action="same-compositor"
    else
        action="cross-compositor"
    fi

    printf "current_compositor=%s
" "$current_comp"
    printf "current_profile=%s
" "$current"
    printf "target_profile=%s
" "$profile"
    printf "target_name=%s
" "$(profile_name "$profile")"
    printf "target_compositor=%s
" "$target_comp"
    printf "installed=%s
" "$installed"
    printf "action=%s
" "$action"
}

write_active_profile() {
    local profile="$1"
    local tmp

    mkdir -p "$STATE_DIR"

    tmp="$STATE_DIR/.active.$$"
    printf "%s\n" "$profile" > "$tmp"
    mv -f "$tmp" "$ACTIVE_FILE"
}

cleanup_current_profile() {
    local current="$1"

    case "$current" in
        serpantinum)
            if command -v serpantinumd >/dev/null 2>&1; then
                serpantinumd stop >/dev/null 2>&1 || true
            fi
            ;;

        end4)
            systemctl --user stop \
                end4-media-backend.service \
                >/dev/null 2>&1 || true
            ;;
    esac
}

activate_same_compositor() {
    local profile="$1"
    local compositor="$2"
    local current target link tmp

    current="$(current_profile)"

    target="$(profile_config_path "$ROOT" "$profile")" || {
        echo "multi-rice-control: incomplete profile: $profile" >&2
        return 4
    }

    case "$compositor" in
        hyprland)
            link="$HYPR_LINK"
            ;;
        niri)
            link="$NIRI_LINK"
            ;;
        *)
            echo "multi-rice-control: unsupported compositor: $compositor" >&2
            return 5
            ;;
    esac

    if [ -e "$link" ] && [ ! -L "$link" ]; then
        echo "multi-rice-control: $link is not a symlink; refusing to replace it" >&2
        return 5
    fi

    cleanup_current_profile "$current"

    tmp="$(dirname "$link")/.multi-rice-switch.$$"
    rm -f "$tmp"

    ln -s "$target" "$tmp"
    mv -Tf "$tmp" "$link"

    write_active_profile "$profile"

    printf "action=activated\n"
    printf "profile=%s\n" "$profile"
    printf "name=%s\n" "$(profile_name "$profile")"
    printf "compositor=%s\n" "$compositor"
    printf "target=%s\n" "$target"
}

switch_profile() {
    local profile="${1:-}"
    local current current_comp target_comp

    if [ -z "$profile" ]; then
        echo "multi-rice-control: switch requires a profile id" >&2
        return 2
    fi

    target_comp="$(profile_compositor "$profile" 2>/dev/null || true)"

    if [ -z "$target_comp" ]; then
        echo "multi-rice-control: unknown profile: $profile" >&2
        return 2
    fi

    if ! is_installed "$profile"; then
        echo "multi-rice-control: $(profile_name "$profile") is not installed" >&2
        return 4
    fi

    current_comp="$(detect_compositor)"
    current="$(current_profile)"

    if [ "$profile" = "$current" ]; then
        printf "action=noop\n"
        printf "profile=%s\n" "$profile"
        printf "name=%s\n" "$(profile_name "$profile")"
        return 0
    fi

    if [ "$current_comp" = "unknown" ]; then
        echo "multi-rice-control: unsupported graphical session" >&2
        return 5
    fi

    if [ "$target_comp" != "$current_comp" ]; then
        echo "multi-rice-control: cross-compositor switching is not enabled yet" >&2
        return 6
    fi

    activate_same_compositor "$profile" "$target_comp" || return $?

    notify-send \
        "Huzaifah Multi-Rice" \
        "Switching to $(profile_name "$profile")…" \
        2>/dev/null || true

    sleep 0.35

    case "$target_comp" in
        hyprland)
            command -v hyprctl >/dev/null 2>&1 || {
                echo "multi-rice-control: hyprctl not found" >&2
                return 5
            }

            if command -v uwsm >/dev/null 2>&1 &&
               systemctl --user --quiet is-active "wayland-wm@hyprland.desktop.service"; then
                uwsm stop
            else
                hyprctl dispatch "hl.dsp.exit()"
            fi
            ;;

        niri)
            echo "multi-rice-control: Niri session exit support not enabled yet" >&2
            return 6
            ;;
    esac
}

case "${1:-status}" in
    compositor)
        detect_compositor
        ;;

    profile)
        current_profile
        ;;

    status)
        show_status
        ;;

    list)
        show_list
        ;;

    plan)
        plan_switch "${2:-}"
        ;;

    switch)
        switch_profile "${2:-}"
        ;;

    *)
        echo "Usage: multi-rice-control {status|list|profile|compositor|plan PROFILE|switch PROFILE}" >&2
        exit 2
        ;;
esac
