#!/usr/bin/env bash
set -e
ROOT="$HOME/.local/share/desktop-profiles/nixri"
export XDG_CONFIG_HOME="$ROOT/support/xdg/config"
export XDG_STATE_HOME="$ROOT/support/xdg/state"
export XDG_CACHE_HOME="$ROOT/support/xdg/cache"
export XDG_DATA_HOME="$ROOT/support/xdg/data"
export QS_ICON_THEME="${QS_ICON_THEME:-Papirus-Dark}"

dms kill >/dev/null 2>&1 || true
sleep 1

LOG="${XDG_RUNTIME_DIR:-/run/user/$UID}/nixri-dms.log"
: > "$LOG"

setsid -f dms run </dev/null >>"$LOG" 2>&1

echo "✅ Astra DMS restarted detached"
echo "   log: $LOG"
