/* Safe fallback palette. Matugen may overwrite this at runtime. */
* {
    primary: #8ecaf9;
    on-primary: #00344f;
    primary-container: #1f4b63;
    on-primary-container: #c8e6ff;
    surface: #101417;
    surface-high: #252a2e;
    on-surface: #e1e3e5;
    on-surface-variant: #c1c7cc;
    outline-variant: #41484d;
    error: #ffb4ab;
    glass: rgba(28, 33, 37, 0.92);
}
