// Waybar - floating islands: every group is its own rounded pill over a
// transparent bar. Colours come from colors.css, generated by matugen.
//
//   left    launcher + clipboard · workspaces · cpu gpu ram
//   centre  clock · music (opens the dashboard's Media tab)
//   right   screenshot + record · notifications · network volume mic · tray
//
// Power and settings live in the control centre's header now.
{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": ["group/launch", "hyprland/workspaces", "group/hw"],
  "modules-center": ["clock", "group/music"],
  "modules-right": ["group/capture", "group/tools", "group/sys", "tray"],

  // ---------------------------------------------------------------- groups --
  "group/launch":  { "orientation": "horizontal", "modules": ["custom/launcher", "custom/clipboard"] },
  "group/hw":      { "orientation": "horizontal", "modules": ["cpu", "custom/gpu", "memory"] },
  "group/capture": { "orientation": "horizontal", "modules": ["custom/screenshot", "custom/record"] },
  "group/tools":   { "orientation": "horizontal", "modules": ["custom/notifications"] },
  "group/sys":     { "orientation": "horizontal", "modules": ["network", "pulseaudio", "pulseaudio#mic"] },
  // A drawer: only the note shows; hovering it slides out the song's name.
  "group/music": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 300, "children-class": "music-child", "transition-left-to-right": true },
    "modules": ["custom/music", "custom/nowplaying"]
  },

  // ------------------------------------------------------------------ left --
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun -theme ~/.local/share/desktop-profiles/sayconlun/support/rofi/launcher.rasi",
    "on-click-right": "rofi -show filebrowser -theme ~/.local/share/desktop-profiles/sayconlun/support/rofi/launcher.rasi"
  },
  "custom/clipboard": {
    "format": "󰅌",
    "tooltip": false,
    "on-click": "~/.local/share/desktop-profiles/sayconlun/support/bin/rice-clipboard",
    "on-click-right": "~/.local/share/desktop-profiles/sayconlun/support/bin/rice-clipboard --wipe"
  },

  // Labelled by {id}, not by name or icon: format-icons matches a workspace's
  // NAME before its number, which is how "{name}" once showed up literally.
  // all-outputs keeps the pills from jumping between bars. Only 1 (main) is
  // always shown; 2 and up appear while they exist.
  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{id}",
    "sort-by": "id",
    "persistent-workspaces": { "1": [] },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

  "cpu": { "interval": 2, "format": "󰻠 {usage}%" },
  "custom/gpu": {
    "exec": "~/.local/share/desktop-profiles/sayconlun/support/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 2
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f}G",
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used"
  },

  // ---------------------------------------------------------------- centre --
  // locale en_US: en_GB renders %p as lowercase "pm".
  "clock": {
    "format": "{:%I:%M %p}",
    "on-click": "qs -c lumina ipc call dashboard toggle",
    "locale": "en_US.UTF-8",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month", "format": { "today": "<b><u>{}</u></b>" } }
  },
  // Music: the dashboard's Media tab (player, seek, transport, visualiser art).
  "custom/music": {
    "format": "󰎈",
    "tooltip-format": "Media",
    "on-click": "qs -c lumina ipc call dashboard tab media",
    "on-click-right": "playerctl play-pause"
  },
  // Song name, revealed by hovering the note. Empty - so nothing slides out -
  // unless something is playing or paused (scripts/nowplaying.sh).
  "custom/nowplaying": {
    "exec": "~/.local/share/desktop-profiles/sayconlun/support/waybar/scripts/nowplaying.sh",
    "return-type": "json",
    "escape": true,
    "max-length": 48,
    "on-click": "qs -c lumina ipc call dashboard tab media",
    "on-click-right": "playerctl play-pause"
  },

  // ----------------------------------------------------------------- right --
  // Screenshot: click = the capture menu, right-click = region into satty.
  "custom/screenshot": {
    "format": "󰹑",
    "tooltip-format": "Screenshot",
    "on-click": "qs -c lumina ipc call capture menu",
    "on-click-right": "grim -g \"$(slurp)\" - | satty -f -"
  },
  // Record: click = record the screen / stop, right-click = record an area.
  // While recording it becomes a red timer (scripts/recording.sh).
  "custom/record": {
    "exec": "~/.local/share/desktop-profiles/sayconlun/support/waybar/scripts/recording.sh",
    "return-type": "json",
    "on-click": "qs -c lumina ipc call capture toggleRecording",
    "on-click-right": "qs -c lumina ipc call capture record area"
  },

  // Bell: state from Quickshell's notification server (NotifService.qml),
  // which sends SIGRTMIN+8 whenever the count or Do Not Disturb changes.
  "custom/notifications": {
    "exec": "~/.local/share/desktop-profiles/sayconlun/support/waybar/scripts/notifications.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "format": "{icon}",
    "format-icons": { "notification": "󰂚", "none": "󰂜", "dnd": "󰂛" },
    "on-click": "qs -c lumina ipc call notifications toggle",
    "on-click-right": "qs -c lumina ipc call notifications toggleDnd"
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} · {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "tooltip-format-disconnected": "offline",
    "on-click": "qs -c lumina ipc call controlcenter toggle",
    "on-click-right": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    // Keys are tried against the default sink's NAME first, then its port
    // type. Headphones on a USB interface often report a plain "analog-output"
    // port - add the sink's name (`pactl list short sinks`) to get the icon.
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "qs -c lumina ipc call controlcenter toggle",
    "on-click-middle": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "tooltip-format": "{source_desc} · {source_volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },

  "tray": { "icon-size": 18, "spacing": 8 }
}
