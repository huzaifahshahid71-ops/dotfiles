#!/usr/bin/env bash
set -e
ROOT="$HOME/.local/share/desktop-profiles/clavis"

export PATH="$ROOT/support/bin:$PATH"
export QML_IMPORT_PATH="$ROOT/support/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QS_ICON_THEME="${QS_ICON_THEME:-Papirus-Dark}"

CLAVIS_LIB_PATH="$(
    find "$ROOT/support/qml/Clavis" -type f -name '*.so' -printf '%h\n' 2>/dev/null |
        sort -u |
        paste -sd: -
)"
export LD_LIBRARY_PATH="$CLAVIS_LIB_PATH${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec qs -c clavis -n -d
