#!/usr/bin/env python3

import os
import socket

runtime_dir = os.environ.get(
    "XDG_RUNTIME_DIR",
    f"/run/user/{os.getuid()}",
)

socket_path = os.path.join(
    runtime_dir,
    "mpv-background-music.sock",
)

command = b'{"command":["quit-watch-later"]}\n'

try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(socket_path)
        client.sendall(command)

        try:
            client.recv(4096)
        except TimeoutError:
            pass
except OSError:
    # MPV may already be closed.
    pass
