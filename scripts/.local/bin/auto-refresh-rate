#!/usr/bin/env bash
set -u

OUTPUT="${REFRESH_OUTPUT:-}"
BATTERY_MODE='modeline 1125.275 2560 2568 2600 2640 1600 3534 3542 3552 -hsync -vsync'
AC_MODE='preferred'
OVERRIDE_FILE="${XDG_RUNTIME_DIR:-/run/user/$UID}/refresh-rate-override"

exec 9>"${XDG_RUNTIME_DIR:-/run/user/$UID}/auto-refresh-rate.lock"
flock -n 9 || exit 0

last_state=""
last_verification=0

find_internal_output() {
    if [[ -n "$OUTPUT" ]]; then
        printf '%s\n' "$OUTPUT"
        return
    fi
    hyprctl -j monitors 2>/dev/null |
        jq -r '(map(select(.name | startswith("eDP-"))) | first | .name) // (first | .name) // empty'
}

OUTPUT="$(find_internal_output)"
[[ -n "$OUTPUT" ]] || { echo "No active display found" >&2; exit 1; }

get_power_state() {
    local result
    result="$(
        busctl --system get-property \
            org.freedesktop.UPower \
            /org/freedesktop/UPower \
            org.freedesktop.UPower \
            OnBattery 2>/dev/null
    )" || return 1

    case "$result" in
        "b true")  printf 'battery\n' ;;
        "b false") printf 'ac\n' ;;
        *) return 1 ;;
    esac
}

monitor_json() {
    hyprctl -j monitors 2>/dev/null |
        jq -c --arg output "$OUTPUT" '.[] | select(.name == $output)'
}

get_refresh_rate() {
    monitor_json | jq -r '.refreshRate // 0'
}

apply_mode() {
    local state="$1" mode result mon pos scale

    if [[ "$state" == "battery" ]]; then
        mode="$BATTERY_MODE"
    else
        mode="$AC_MODE"
    fi

    mon="$(monitor_json)"
    [[ -n "$mon" ]] || return 1
    pos="$(printf '%s\n' "$mon" | jq -r '(.x|tostring) + "x" + (.y|tostring)')"
    scale="$(printf '%s\n' "$mon" | jq -r '.scale // 1.25')"

    result="$(
        hyprctl eval "hl.monitor({
            output = \"$OUTPUT\",
            mode = \"$mode\",
            position = \"$pos\",
            scale = $scale
        })" 2>&1
    )"

    if [[ "$result" == "ok" ]]; then
        echo "Power state: $state — refresh-rate command applied on $OUTPUT"
        return 0
    fi

    echo "Failed to apply $state mode: $result" >&2
    return 1
}

echo "Automatic G16 refresh-rate service started on $OUTPUT"

while true; do
    state="$(get_power_state)" || {
        echo "Could not read UPower state" >&2
        sleep 2
        continue
    }

    now="$(date +%s)"
    should_apply=false

    # Charger transitions always restore the default 120/240 policy and end
    # any temporary manual refresh override selected from SUPER+SHIFT+R.
    if [[ "$state" != "$last_state" ]]; then
        rm -f "$OVERRIDE_FILE"
        echo "Power-state change detected: ${last_state:-unknown} -> $state"
        should_apply=true

    # While a manual selection is active, do not fight the refresh switcher.
    elif [[ -f "$OVERRIDE_FILE" ]]; then
        last_verification="$now"

    # Periodically recover from a Hyprland reload that re-applied preferred.
    elif (( now - last_verification >= 30 )); then
        refresh="$(get_refresh_rate)"

        if [[ "$state" == "battery" ]]; then
            awk -v hz="$refresh" 'BEGIN { exit !(hz > 180) }' && should_apply=true
        else
            awk -v hz="$refresh" 'BEGIN { exit !(hz < 200) }' && should_apply=true
        fi

        last_verification="$now"
    fi

    if [[ "$should_apply" == true ]]; then
        if apply_mode "$state"; then
            last_state="$state"
            last_verification="$now"
        fi
    else
        last_state="$state"
    fi

    sleep 1
done
